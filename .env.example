PORT=8080
ENVIRONMENT=development

COOKIE_SIGN=your-secret-with-minimum-length-of-32-characters
AUTH_ENABLED=true
SSO_ISSUER_HOST=https://auth.example.com/auth/realms/YourRealm
SSO_CLIENT_ID=your-client-id
SSO_CLIENT_SECRET=your-client-secret
SSO_CALLBACK_URL=http://localhost:8080/auth/callback/oidc

AGENT_HOST=http://localhost:5002
EVAL_HOST=http://127.0.0.1:8099

CORS_ORIGIN=http://localhost:8080

# Redis (optional — falls back to in-memory sessions when absent)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=false

# Group-based access restriction (requires AUTH_ENABLED=true)
# When true, only members of DEVELOPER_GROUP or USER_GROUP can access the UI.
# Eval, dataset page, and developer settings require DEVELOPER_GROUP.
# USER_GROUP members get viewer access (no eval/dataset/developer features).
# No effect when AUTH_ENABLED=false (dev bypass grants full developer access).
RESTRICT_TO_GROUPS=false
# DEVELOPER_GROUP=lightspeed-developer
# USER_GROUP=lightspeed-user
